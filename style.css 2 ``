*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{

background:url("img/fondo.jpg");
background-size:cover;

padding:20px;
}

.contenedor{

max-width:900px;

margin:auto;

background:white;

border-radius:20px;

padding:20px;

box-shadow:0 0 20px rgba(0,0,0,.2);
}

.logo{

width:220px;

display:block;

margin:auto;
}

h1{

text-align:center;

margin-top:10px;

color:#b38b2e;
}

.nombre-box{

margin:20px 0;
}

.nombre-box input{

width:100%;

padding:15px;

font-size:18px;

border-radius:10px;

border:1px solid #ccc;
}

.partido{

display:grid;

grid-template-columns:
80px
1fr
80px
1fr
80px;

align-items:center;

gap:10px;

padding:15px;

border-bottom:1px solid #ddd;
}

.equipo{

text-align:center;

font-weight:bold;
}

.equipo img{

width:50px;

display:block;

margin:auto;
}

.opcion{

height:60px;

border-radius:12px;

border:2px solid #ccc;

font-size:28px;

font-weight:bold;

cursor:pointer;

background:white;
}

.opcion.activa{

background:#d4af37;

color:white;

border-color:#d4af37;
}

.resumen{

display:flex;

justify-content:space-between;

margin-top:20px;

font-size:22px;

font-weight:bold;
}

.botones{

margin-top:20px;

display:flex;

gap:15px;
}

button{

flex:1;

padding:15px;

border:none;

border-radius:12px;

font-size:18px;

cursor:pointer;
}

.btn-whatsapp{

background:#0c9e39;

color:white;
}

@media(max-width:768px){

.partido{

grid-template-columns:
60px
1fr
60px
1fr
60px;
}

.equipo{

font-size:12px;
}

}
